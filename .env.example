# OpenAI API Configuration (required for Hermes)
OPENAI_API_KEY=your_openai_api_key_here

# Email Configuration (for POC)
EMAIL_PROVIDER=mock
# EMAIL_ADDRESS=
# EMAIL_PASSWORD=

# Hermes Agent Configuration
HERMES_SESSION_ID=poc-session
# Path to MCP server entry point (required for Hermes integration)
MCP_SERVER_PATH=/Users/youruser/path/to/whatsapp-secretary/packages/mcp-server/dist/mcp-index.js

# Control Plane Configuration
PORT=3000

# WhatsApp Cloud API Configuration
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-secret
WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-from-meta
WHATSAPP_ACCESS_TOKEN=your-access-token-from-meta
WHATSAPP_GRAPH_API_VERSION=v26.0
# For Meta Test webhook (fake sender), send replies to this number instead
WHATSAPP_TEST_RECIPIENT=972541234567

# Test Message Override (optional - for testing Hermes with specific messages)
# When set, this message is sent to Hermes instead of the actual webhook message text.
# The original webhook is still validated normally (signature check, parsing, etc).
# Leave empty to use real webhook messages.
# Example: WHATSAPP_TEST_MESSAGE_OVERRIDE=תראה לי את חמשת המיילים האחרונים
WHATSAPP_TEST_MESSAGE_OVERRIDE=

# Future: Database Configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_secretary
