# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4-turbo-preview

# Email Configuration (for POC)
# Choose either 'gmail' or 'outlook'
EMAIL_PROVIDER=gmail
EMAIL_ADDRESS=your_email@example.com

# IMPORTANT: Use App-Specific Password, NOT your regular Gmail/Outlook password!
# Gmail App Password: https://myaccount.google.com/apppasswords (requires 2FA enabled)
# Outlook App Password: https://account.microsoft.com/security (requires 2FA enabled)
# Alternative: Use OAuth2 flow (will be supported in future versions)
EMAIL_PASSWORD=your_app_password_here

# Hermes Agent Configuration
HERMES_API_URL=http://localhost:3000
HERMES_SESSION_ID=poc-session

# MCP Server Configuration
MCP_SERVER_PORT=3001

# Future: WhatsApp Configuration (Phase 2)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Future: Database Configuration (Phase 2)
# DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_secretary
