{
  "name": "@whatsapp-secretary/control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP control plane for WhatsApp webhooks",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --build",
